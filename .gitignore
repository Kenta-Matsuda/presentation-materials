# 各スライドの元ファイル（Marp の slides.md・テーマ・ツール・図の元）は、
# スライドと同じディレクトリに置くが、コミットしない。公開するのは index.html と assets/ の画像だけ
/[0-9][0-9][0-9][0-9]_[0-9][0-9]/*/*
!/[0-9][0-9][0-9][0-9]_[0-9][0-9]/*/index.html
!/[0-9][0-9][0-9][0-9]_[0-9][0-9]/*/assets/
/[0-9][0-9][0-9][0-9]_[0-9][0-9]/*/assets/**/*.html
/[0-9][0-9][0-9][0-9]_[0-9][0-9]/*/assets/**/*.css
/[0-9][0-9][0-9][0-9]_[0-9][0-9]/*/assets/**/*.js
/[0-9][0-9][0-9][0-9]_[0-9][0-9]/*/assets/icons/
/[0-9][0-9][0-9][0-9]_[0-9][0-9]/*/assets/.gitkeep
